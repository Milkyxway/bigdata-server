{
  "name": "task-backend",
  "version": "1.0.0",
  "description": "task api base on eggjs",
  "private": true,
  "egg": {
    "declarations": true
  },
  "dependencies": {
    "dayjs": "^1.11.9",
    "egg": "^3",
    "egg-cors": "^2.2.3",
    "egg-mysql": "^4.0.0",
    "egg-scripts": "^2",
    "ftp": "^0.3.10",
    "mkdirp": "^3.0.1",
    "moment": "^2.29.4",
    "ssh2-sftp-client": "^12.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "egg-bin": "^5",
    "egg-ci": "^2",
    "egg-mock": "^5",
    "eslint": "^8",
    "eslint-config-egg": "^12"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "start": "egg-scripts start --daemon --title=egg-server-task-backend",
    "stop": "egg-scripts stop --title=egg-server-task-backend",
    "dev": "egg-bin dev",
    "debug": "egg-bin debug",
    "test": "npm run lint -- --fix && npm run test-local",
    "test-local": "egg-bin test",
    "cov": "egg-bin cov",
    "lint": "eslint .",
    "ci": "npm run lint && npm run cov"
  },
  "ci": {
    "version": "16, 18",
    "type": "github"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "xjs",
  "license": "MIT"
}